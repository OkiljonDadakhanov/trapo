# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trapo?retryWrites=true&w=majority

# JWT secret - use a strong random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server port
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Admin creation secret - required for creating admin accounts
# Remove this variable in production after initial admin is created
ADMIN_CREATION_SECRET=your-admin-creation-secret
